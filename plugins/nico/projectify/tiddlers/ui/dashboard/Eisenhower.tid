caption: {{$:/plugins/nico/projectify/images/grid}} {{$:/language/projectify/Eisenhower}}
created: 20240214000000000
modified: 20240214000000000
tags: $:/plugins/nico/projectify/tags/dashboard
title: $:/plugins/nico/projectify/ui/dashboard/Eisenhower
type: text/vnd.tiddlywiki

\define lingo-base() $:/language/projectify/

\define quadrant-drop-actions()
  <$list filter="[<actionTiddler>tag[todo]!has[draft.of]]" variable="ignore">
    <$action-listops $tiddler=<<actionTiddler>> $field="tags" $subfilter="-Inbox"/>
    <$action-setfield $tiddler=<<actionTiddler>> quadrant=<<quadrant>>/>
    <$action-sendmessage $message="tm-auto-save-wiki"/>
  </$list>
\end

\define quadrant-cell(qid titleKey)
  <$vars quadrant=<<__qid__>>>
    <div class={{{ [[py-quadrant py-quadrant-]addsuffix<__qid__>] }}}>
      <div class="py-quadrant-header">
        <h3>{{$:/language/projectify/$titleKey$}}</h3>
        <span class="py-count info">
          <$count filter="[all[tiddlers]tag[todo]!has[draft.of]!tag[done]!nsort[priority]] :filter[get[quadrant]else[eliminate]match<__qid__>]"/>
        </span>
      </div>
      <div class="py-quadrant-description">{{$:/language/projectify/$titleKey$/Description}}</div>
      <$droppable tag="div" class="py-quadrant-drop" actions=<<quadrant-drop-actions>>>
        <div class="py-todos">
          <$list
            filter="[all[tiddlers]tag[todo]!has[draft.of]!tag[done]!nsort[priority]] :filter[get[quadrant]else[eliminate]match<__qid__>]"
            template="$:/plugins/nico/projectify/ui/todo/TodoItem"
            emptyMessage="<div class='py-quadrant-empty'>{{$:/language/projectify/Eisenhower/Empty}}</div>"
          />
        </div>
      </$droppable>
    </div>
  </$vars>
\end

<$vars showProjectLinks="yes" dragHandle="yes">
  <label class="py-label">
    {{$:/language/projectify/Eisenhower/Hint}}
  </label>

  <div class="py-quadrant-layout">
    <div class="py-quadrant-matrix">
      <div class="py-quadrant-axis"></div>
      <div class="py-quadrant-axis py-quadrant-axis-column">{{$:/language/projectify/Eisenhower/Urgent}}</div>
      <div class="py-quadrant-axis py-quadrant-axis-column">{{$:/language/projectify/Eisenhower/NotUrgent}}</div>
      <div class="py-quadrant-axis py-quadrant-axis-row">{{$:/language/projectify/Eisenhower/Important}}</div>
      <<quadrant-cell do Eisenhower/DoFirst>>
      <<quadrant-cell schedule Eisenhower/Schedule>>
      <div class="py-quadrant-axis py-quadrant-axis-row">{{$:/language/projectify/Eisenhower/NotImportant}}</div>
      <<quadrant-cell delegate Eisenhower/Delegate>>
      <<quadrant-cell eliminate Eisenhower/Eliminate>>
    </div>
  </div>
</$vars>
