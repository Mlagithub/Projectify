modified: 20240214000000000
tags:
title: $:/plugins/nico/projectify/ui/dashboard/QuadrantTodoItem
type: text/vnd.tiddlywiki

\define drag-handle()
  <$draggable
    tag="span"
    class="py-drag-handle"
    tiddler={{!!title}}>
      {{$:/plugins/nico/projectify/images/drag-handle}}
  </$draggable>
\end

<div class={{{ [all[current]tag[done]then[py-todo py-completed]else[py-todo]] }}}>
  <<drag-handle>>

  <$checkbox tag="done" checkactions=<<py-mark-as-done>> uncheckactions=<<py-unmark-as-done-and-check-recurring>>>
    {{||$:/plugins/nico/projectify/ui/buttons/Checkbox}}
    <$link to={{!!title}}>
      {{||$:/plugins/nico/projectify/ui/todo/TodoCaption}}
    </$link>
  </$checkbox>

  <$list filter="[all[current]has[quadrant]]">
    <span class="py-todo-actions">
      <$button
        class="py-btn"
        tooltip={{$:/language/projectify/Eisenhower/BackToInbox}}
        aria-label={{$:/language/projectify/Eisenhower/BackToInbox}}
      >
        {{$:/plugins/nico/projectify/images/slash-circle}}
        <$action-listops $tags="-Inbox -Project -SubProject Inbox"/>
        <$action-deletefield quadrant/>
        <$action-sendmessage $message="tm-auto-save-wiki"/>
      </$button>
    </span>
  </$list>
</div>
